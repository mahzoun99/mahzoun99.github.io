---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const posts = (await getCollection('posts')).filter(({ data }) => !data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<Layout title="Blog - Ali">
	<div class="page-header"><p class="section-label">/ journal</p><h1>Thoughts,<br /><em>in progress.</em></h1><p class="hero-copy">Notes on software, design, and the process of making things.</p></div>
	<section class="section"><div class="writing-list">{posts.map((post) => <a class="writing-item" href={`${base}blog/${post.id}`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: '2-digit' })}</time><h3>{post.data.title}</h3><span>Read →</span></a>)}</div></section>
</Layout>
